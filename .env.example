# Copiez ces variables dans Vercel › Project › Settings › Environment Variables

# Mot de passe de l'administration (obligatoire)
ADMIN_PASSWORD=
# Longue chaîne aléatoire pour signer les sessions (recommandé)
SESSION_SECRET=

# Base de données : ajoutées AUTOMATIQUEMENT en connectant Upstash Redis (Vercel › Storage)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Préfixe des clés (facultatif). Garder « prog10 » permet de réutiliser
# la même base Upstash que la plateforme des résumés sans mélange.
# DB_PREFIX=prog10
